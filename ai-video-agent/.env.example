# Copy this file to .env and fill in the providers you want to use.

# LLM planner. If omitted, the pipeline uses a local fallback story plan.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Narration. If omitted, the pipeline renders silent audio so the video still builds.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel

# Optional video provider hook. If omitted, FFmpeg placeholder clips are rendered locally.
# Tokens available: {scene_json} {output_path} {prompt} {duration}
# Example:
# VIDEO_PROVIDER_COMMAND=python tools/kling_generate.py --scene {scene_json} --out {output_path}
VIDEO_PROVIDER_COMMAND=

OUTPUT_ROOT=outputs
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DEFAULT_CLIP_SECONDS=8
DEFAULT_SCENE_COUNT=36
DEFAULT_SHORT_COUNT=20

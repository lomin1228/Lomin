# Copy to studio/.env. Leave a variable empty if that provider should stay unavailable.
# Never commit real keys.

# Optional. When unset, Claude is not called. This episode's research and script
# are stored in src/content and were not produced by a live model call.
ANTHROPIC_API_KEY=

# Optional speech provider. This build narrates with the local edge-tts adapter.
ELEVENLABS_API_KEY=

# Optional image and video providers. Final shots in the pilot are Remotion
# drawings, so these keys are not required to export the film.
FAL_KEY=
RUNWAY_API_KEY=

# edge-tts is the configured speech provider for the pilot.
SPEECH_PROVIDER=edge-tts
